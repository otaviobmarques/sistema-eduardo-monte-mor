# Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://klctfofigyukwldcvsue.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=

# Domínio sintético para logins que não são e-mail (ex.: "creditas" → creditas@login.autovisao.app)
LOGIN_EMAIL_DOMAIN=login.autovisao.app

# Web Push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@autovisao.com.br

# Protege o endpoint /api/cron/* (Vercel Cron envia Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Usuário Loja inicial (npm run seed:admin)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NOME=Gestor Auto Visão
SEED_ADMIN_SENHA=

# Cobrança das Lojas pelo Asaas (Administrador)
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
ASAAS_WEBHOOK_TOKEN=
